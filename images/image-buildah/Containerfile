ARG BUILD_USER=buildah
ARG BUILD_UID=1000
ARG BUILD_GID=1000

FROM harbor.okwilkins.dev/docker-hub-cache/nixos/nix:2.35.6 AS builder

RUN printf '%s\n' \
    'experimental-features = nix-command flakes' \
    'filter-syscalls = false' \
    'build-users-group =' >> /etc/nix/nix.conf

WORKDIR /tmp/build
COPY flake.nix flake.lock ./

RUN nix build .#image-tools && nix build .#setcap --out-link setcap

ARG BUILD_USER
ARG BUILD_UID
ARG BUILD_GID

COPY prepare-rootfs.py ./
RUN nix run .#prepare-rootfs -- /tmp/rootfs "${BUILD_USER}" "${BUILD_UID}" "${BUILD_GID}"

FROM scratch

ARG BUILD_USER
ARG BUILD_UID
ARG BUILD_GID

LABEL "io.containers.capabilities"="CHOWN,DAC_OVERRIDE,FOWNER,FSETID,KILL,NET_BIND_SERVICE,SETFCAP,SETGID,SETPCAP,SETUID,SYS_CHROOT"

ENV PATH="/usr/local/bin:/opt/tools/bin"
# Set an environment variable to default to chroot isolation for RUN
# instructions and "buildah run".
ENV BUILDAH_ISOLATION=chroot
ENV HOME=/home/${BUILD_USER}
ENV XDG_RUNTIME_DIR=/run/user/${BUILD_UID}
# Select the same storage configuration for rootful and rootless builds.
ENV CONTAINERS_STORAGE_CONF=/etc/containers/storage.conf

COPY --from=builder /tmp/rootfs/ /

RUN --mount=type=bind,from=builder,source=/tmp/build/setcap/bin/setcap,target=/tmp/setcap,ro \
    /tmp/setcap cap_setuid=ep /usr/local/bin/newuidmap && \
    /tmp/setcap cap_setgid=ep /usr/local/bin/newgidmap

VOLUME /var/tmp
VOLUME /home/${BUILD_USER}/.local/share/containers

USER ${BUILD_UID}:${BUILD_GID}

