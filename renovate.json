{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "registryAliases": {
        "harbor.okwilkins.dev/docker-hub-cache": "index.docker.io",
        "harbor.okwilkins.dev/ghcr-cache": "ghcr.io"
    },
    "dependencyDashboard": true,
    "automerge": false,
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "argocd": {
        "managerFilePatterns": [
            "/ci-cd/argocd/.*/.*\\.ya?ml$/"
        ]
    },
    "kubernetes": {
        "managerFilePatterns": [
            "/.*\\.yaml$/",
            "/.*\\.yml$/"
        ],
        "ignorePaths": [
            "infrastructure/",
            "**/docker-compose*.yaml"
        ]
    },
    "terraform": {},
    "nix": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update Kustomize remote resource URLs",
            "managerFilePatterns": [
                "/.*/kustomization\\.yaml$/"
            ],
            "matchStrings": [
                "-\\s+https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?:refs/tags/)?(?<currentValue>v?\\d[^/]*)/.*"
            ],
            "datasourceTemplate": "github-tags",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "Update CloudNativePG PostgreSQL images",
            "managerFilePatterns": [
                "/storage/cloudnative-pg/.*\\.yaml$/"
            ],
            "matchStrings": [
                "imageName:\\s+(?<depName>[^\\s]+):(?<currentValue>[^\\s]+)"
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Update stable nixpkgs channels in the Buildah image",
            "managerFilePatterns": [
                "/^images/image-buildah/flake\\.nix$/"
            ],
            "matchStrings": [
                "nixpkgs\\.url\\s*=\\s*\"github:NixOS/nixpkgs/(?<currentValue>nixos-\\d{2}\\.\\d{2})\""
            ],
            "depNameTemplate": "nixpkgs",
            "packageNameTemplate": "https://github.com/NixOS/nixpkgs",
            "datasourceTemplate": "git-refs",
            "versioningTemplate": "nixpkgs"
        },
        {
            "customType": "regex",
            "description": "Update the Grafana operand version",
            "managerFilePatterns": [
                "/^observability/grafana/environments/prod/grafana\\.yaml$/"
            ],
            "matchStrings": [
                "(?:^|\\r?\\n)  version:\\s*[\"']?(?<currentValue>[^\\s\"']+)"
            ],
            "depNameTemplate": "docker.io/grafana/grafana",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": "Label major updates for manual review",
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "major-update"
            ]
        },
        {
            "description": "Keep PostgreSQL images on stable numeric tags",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/cloudnative-pg/postgresql"
            ],
            "allowedVersions": "/^[0-9]+(?:\\.[0-9]+)*$/"
        },
        {
            "description": "Require approval before proposing PostgreSQL major upgrades",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/cloudnative-pg/postgresql"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Use regex channel updates while retaining native Nix lock maintenance",
            "matchManagers": [
                "nix"
            ],
            "matchFileNames": [
                "images/image-buildah/flake.nix"
            ],
            "matchPackageNames": [
                "https://github.com/NixOS/nixpkgs"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ],
            "enabled": false
        },
        {
            "description": "Refresh the Buildah flake lock after a stable channel update",
            "matchManagers": [
                "custom.regex"
            ],
            "matchFileNames": [
                "images/image-buildah/flake.nix"
            ],
            "matchPackageNames": [
                "https://github.com/NixOS/nixpkgs"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "nix --extra-experimental-features 'nix-command flakes' flake update nixpkgs"
                ],
                "workingDirTemplate": "{{{packageFileDir}}}",
                "fileFilters": [
                    "images/image-buildah/flake.lock"
                ],
                "executionMode": "update",
                "installTools": {
                    "nix": {}
                }
            }
        },
        {
            "description": "Compare SearxNG release dates while ignoring the commit hash",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "index.docker.io/searxng/searxng"
            ],
            "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-[a-f0-9]+$",
            "minimumReleaseAge": "7 days"
        },
        {
            "description": "Group native updates to the shared bootstrap providers and lock file",
            "matchManagers": [
                "terraform"
            ],
            "matchDatasources": [
                "terraform-provider"
            ],
            "matchFileNames": [
                "infrastructure/shared/providers.tf"
            ],
            "groupName": "bootstrap Terraform providers",
            "groupSlug": "bootstrap-terraform-providers",
            "separateMajorMinor": false
        }
    ]
}
