{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "registryAliases": {
        "harbor.okwilkins.dev/docker-hub-cache": "index.docker.io",
        "harbor.okwilkins.dev/ghcr-cache": "ghcr.io"
    },
    "dependencyDashboard": true,
    "automerge": false,
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "argocd": {
        "managerFilePatterns": [
            "/ci-cd/argocd/.*/.*\\.ya?ml$/"
        ]
    },
    "kubernetes": {
        "managerFilePatterns": [
            "/.*\\.yaml$/",
            "/.*\\.yml$/"
        ],
        "ignorePaths": [
            "infrastructure/",
            "**/docker-compose*.yaml"
        ]
    },
    "terraform": {},
    "nix": {
        "enabled": true
    },
    "lockFileMaintenance": {
        "enabled": true
    },
    "customDatasources": {
        "harbor-main": {
            "defaultRegistryUrlTemplate": "https://harbor.okwilkins.dev/api/v2.0/projects/main/repositories/{{packageName}}/artifacts?q=tags%3D*&sort=-push_time&page_size=100&with_accessory=true",
            "transformTemplates": [
                "{\"releases\": [$[type = 'IMAGE' and 'signature.cosign' in accessories.type][0].{'version': '1.0.0', 'digest': digest, 'releaseTimestamp': push_time}]}"
            ]
        }
    },
    "customManagers": [
        {
            "customType": "regex",
            "description": "Track the newest signed Harbor main image by digest in workloads and Argo parameters",
            "managerFilePatterns": ["/\\.ya?ml$/"],
            "matchStrings": [
                "(?:^|\\n)[ \\t]*(?:- )?(?:image|value):[ \\t]+[\"']?(?<depName>harbor\\.okwilkins\\.dev/main/(?<packageName>[a-z0-9][a-z0-9._-]*))@(?<currentDigest>sha256:[a-f0-9]{64})"
            ],
            "currentValueTemplate": "1.0.0",
            "versioningTemplate": "semver",
            "datasourceTemplate": "custom.harbor-main"
        },
        {
            "customType": "regex",
            "description": "Update the Excalidraw release commit in its build sensor",
            "managerFilePatterns": [
                "/^ci-cd/argo-events/environments/prod/sensors/excalidraw-image-sensor\\.yaml$/"
            ],
            "matchStrings": [
                "- name: image-tag\\s+value: \"(?<currentDigest>[a-f0-9]{40})\""
            ],
            "currentValueTemplate": "release",
            "depNameTemplate": "excalidraw/excalidraw",
            "packageNameTemplate": "https://github.com/excalidraw/excalidraw.git",
            "datasourceTemplate": "git-refs"
        },
        {
            "customType": "regex",
            "description": "Update the Talos bootstrap version",
            "managerFilePatterns": [
                "/^infrastructure/shared/common\\.auto\\.tfvars$/"
            ],
            "matchStrings": [
                "(?:^|\\r?\\n)[ \\t]*talos_version[ \\t]*=[ \\t]*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
            ],
            "depNameTemplate": "siderolabs/talos",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "Update the Kubernetes version pin",
            "managerFilePatterns": [
                "/^infrastructure/shared/common\\.auto\\.tfvars$/"
            ],
            "matchStrings": [
                "(?:^|\\r?\\n)[ \\t]*kubernetes_version[ \\t]*=[ \\t]*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
            ],
            "depNameTemplate": "kubernetes/kubernetes",
            "datasourceTemplate": "github-releases",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "Update Argo Events JetStream versions and controller image mappings",
            "managerFilePatterns": [
                "/^ci-cd/argo-events/.*\\.yaml$/"
            ],
            "matchStrings": [
                "# renovate: image=docker\\.io/(?<imagePath>[^\\s]+)\\r?\\n[ \\t]*(?:- )?version:[ \\t]+(?<currentValue>[^\\s]+)",
                "(?:natsImage|metricsExporterImage|configReloaderImage):[ \\t]+(?:docker\\.io/|harbor\\.okwilkins\\.dev/docker-hub-cache/)(?<imagePath>[^\\s:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
            ],
            "depNameTemplate": "docker.io/{{{imagePath}}}",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Update Kustomize remote resource URLs",
            "managerFilePatterns": [
                "/.*/kustomization\\.yaml$/"
            ],
            "matchStrings": [
                "-\\s+https://raw\\.githubusercontent\\.com/(?<depName>[^/]+/[^/]+)/(?:refs/tags/)?(?<currentValue>v?\\d[^/]*)/.*"
            ],
            "datasourceTemplate": "github-tags",
            "versioningTemplate": "semver"
        },
        {
            "customType": "regex",
            "description": "Update CloudNativePG PostgreSQL and pgvector images",
            "managerFilePatterns": [
                "/storage/cloudnative-pg/.*\\.yaml$/"
            ],
            "matchStrings": [
                "imageName:\\s+(?<depName>[^\\s:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?",
                "reference:\\s+(?<depName>ghcr\\.io/cloudnative-pg/pgvector):(?<currentValue>\\d+\\.\\d+\\.\\d+-18-trixie)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
            ],
            "depTypeTemplate": "image",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Update CloudNativePG pgvector extension versions",
            "managerFilePatterns": [
                "/^storage/cloudnative-pg/.*/database\\.yaml$/"
            ],
            "matchStrings": [
                "# renovate: pgvector=18-trixie\\r?\\n(?<indentation>[ \\t]*)version: \\\"(?<extensionVersion>\\d+\\.\\d+\\.\\d+)\\\""
            ],
            "depNameTemplate": "ghcr.io/cloudnative-pg/pgvector",
            "depTypeTemplate": "extension",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker",
            "currentValueTemplate": "{{{extensionVersion}}}-18-trixie",
            "autoReplaceStringTemplate": "# renovate: pgvector=18-trixie\n{{{indentation}}}version: \"{{{lookup (split newValue '-') 0}}}\""
        },
        {
            "customType": "regex",
            "description": "Update the Talos-managed CoreDNS image",
            "managerFilePatterns": [
                "/^infrastructure/03-talos-configure/main\\.tf$/"
            ],
            "matchStrings": [
                "image\\s*=\\s*\"(?<depName>docker\\.io/coredns/coredns):(?<currentValue>[^\\s\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
            ],
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Update stable nixpkgs channels in workflow images",
            "managerFilePatterns": [
                "/^images/(image-buildah|cosign|readme-badges)/flake\\.nix$/"
            ],
            "matchStrings": [
                "nixpkgs\\.url\\s*=\\s*\"github:NixOS/nixpkgs/(?<currentValue>nixos-\\d{2}\\.\\d{2})\""
            ],
            "depNameTemplate": "nixpkgs",
            "packageNameTemplate": "https://github.com/NixOS/nixpkgs",
            "datasourceTemplate": "git-refs",
            "versioningTemplate": "nixpkgs"
        },
        {
            "customType": "regex",
            "description": "Update the Grafana operand version",
            "managerFilePatterns": [
                "/^observability/grafana/environments/prod/grafana\\.yaml$/"
            ],
            "matchStrings": [
                "(?:^|\\r?\\n)  version:\\s*[\"']?(?<currentValue>[^\\s\"']+)"
            ],
            "depNameTemplate": "docker.io/grafana/grafana",
            "datasourceTemplate": "docker",
            "versioningTemplate": "docker"
        },
        {
            "customType": "regex",
            "description": "Update the VictoriaLogs Grafana plugin",
            "managerFilePatterns": [
                "/^observability/grafana/environments/prod/datasources/victorialogs-default\\.yaml$/"
            ],
            "matchStrings": [
                "- name:\\s+victoriametrics-logs-datasource\\s+version:\\s*[\"']?(?<currentValue>[^\\s\"']+)"
            ],
            "depNameTemplate": "victoriametrics-logs-datasource",
            "packageNameTemplate": "VictoriaMetrics/victorialogs-datasource",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$",
            "versioningTemplate": "semver"
        }
    ],
    "packageRules": [
        {
            "description": "Use the Harbor artifact datasource for project main digest pins",
            "matchDatasources": ["docker"],
            "matchPackageNames": ["harbor.okwilkins.dev/main/**"],
            "matchCurrentValue": "latest",
            "enabled": false
        },
        {
            "description": "Update the pgvector image and SQL extension together, retaining PostgreSQL 18 and Trixie compatibility",
            "matchPackageNames": [
                "ghcr.io/cloudnative-pg/pgvector"
            ],
            "allowedVersions": "/^[0-9]+\\.[0-9]+\\.[0-9]+-18-trixie$/",
            "groupName": "CloudNativePG pgvector",
            "groupSlug": "cloudnativepg-pgvector"
        },
        {
            "description": "Retain digest pins on the pgvector image, not the SQL extension version",
            "matchPackageNames": [
                "ghcr.io/cloudnative-pg/pgvector"
            ],
            "matchDepTypes": [
                "image"
            ],
            "pinDigests": true
        },
        {
            "description": "Label major updates for manual review",
            "matchUpdateTypes": [
                "major"
            ],
            "labels": [
                "dependencies",
                "major-update"
            ]
        },
        {
            "description": "Keep PostgreSQL images minimal with digest pins; review Debian migrations separately",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/cloudnative-pg/postgresql"
            ],
            "allowedVersions": "/^[0-9]+\\.[0-9]+-minimal-[a-z]+$/",
            "pinDigests": true
        },
        {
            "description": "Retain digest pins for the Talos-managed CoreDNS image",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "docker.io/coredns/coredns"
            ],
            "pinDigests": true
        },
        {
            "description": "Require approval before proposing PostgreSQL major upgrades",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "ghcr.io/cloudnative-pg/postgresql"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Use regex channel updates while retaining native Nix lock maintenance",
            "matchManagers": [
                "nix"
            ],
            "matchFileNames": [
                "images/image-buildah/flake.nix",
                "images/cosign/flake.nix"
            ],
            "matchPackageNames": [
                "https://github.com/NixOS/nixpkgs"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ],
            "enabled": false
        },
        {
            "description": "Refresh workflow image flake locks after stable channel updates",
            "matchManagers": [
                "custom.regex"
            ],
            "matchFileNames": [
                "images/image-buildah/flake.nix",
                "images/cosign/flake.nix"
            ],
            "matchPackageNames": [
                "https://github.com/NixOS/nixpkgs"
            ],
            "postUpgradeTasks": {
                "commands": [
                    "nix --extra-experimental-features 'nix-command flakes' flake update nixpkgs"
                ],
                "workingDirTemplate": "{{{packageFileDir}}}",
                "fileFilters": [
                    "images/image-buildah/flake.lock",
                    "images/cosign/flake.lock"
                ],
                "executionMode": "update",
                "installTools": {
                    "nix": {}
                }
            }
        },
        {
            "description": "Compare SearxNG release dates while ignoring the commit hash",
            "matchDatasources": [
                "docker"
            ],
            "matchPackageNames": [
                "index.docker.io/searxng/searxng"
            ],
            "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-[a-f0-9]+$",
            "minimumReleaseAge": "7 days"
        },
        {
            "description": "Group native updates to the shared bootstrap providers and lock file",
            "matchManagers": [
                "terraform"
            ],
            "matchDatasources": [
                "terraform-provider"
            ],
            "matchFileNames": [
                "infrastructure/shared/providers.tf"
            ],
            "groupName": "bootstrap Terraform providers",
            "groupSlug": "bootstrap-terraform-providers",
            "separateMajorMinor": false
        }
    ]
}
